{
  "manifest_version": 3,
  "name": "Coinly - Convertisseur de devises",
  "version": "1.0.0",
  "description": "Convertisseur de devises instantané avec design Coinly",
  "permissions": ["storage"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ouvrir Coinly",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
